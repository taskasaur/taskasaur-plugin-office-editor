{
  "id": "office-editor",
  "name": "Office Editor",
  "description": "Offline documents, spreadsheets, and presentations.",
  "version": "1.1.0",
  "platformApi": "^1.0.0",
  "fieldSchemaApi": "^1.0.0",
  "publisher": "taskasaur",
  "license": "GPL-3.0-only",
  "entrypoints": {
    "browser": "browser.mjs"
  },
  "ui": {
    "mode": "shared",
    "apiVersion": "^1.0.0",
    "surfaces": [
      "office-editor"
    ]
  },
  "storage": {
    "local": {
      "mode": "dexie",
      "collections": [
        "office"
      ]
    }
  },
  "permissions": [
    "office-editor.read",
    "office-editor.write"
  ],
  "dependencies": [],
  "features": {},
  "sharedServices": [
    {
      "id": "core.records",
      "version": "^1",
      "optional": false
    },
    {
      "id": "files.access",
      "version": "^1",
      "optional": false
    },
    {
      "id": "core.ui",
      "version": "^1",
      "optional": false
    },
    {
      "id": "core.workspace",
      "version": "^1",
      "optional": false
    },
    {
      "id": "core.sync",
      "version": "^1",
      "optional": false
    },
    {
      "id": "core.storage.local",
      "version": "^1",
      "optional": false
    }
  ],
  "provides": {
    "commands": [
      "office.list",
      "office.put",
      "office.delete"
    ],
    "events": [
      "office.changed"
    ]
  },
  "consumes": {
    "commands": [
      "files.list",
      "files.put",
      "files.delete"
    ],
    "events": []
  }
}
